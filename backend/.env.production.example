# =============================================================================
# BACKEND — production (cabinet.wilaya-tlemcen.dz + /api)
# =============================================================================
# On cPanel:
#   1. Copy this file to the server as wali-api/.env (Run script does NOT see UI env vars)
#   2. Fill secrets, then: npm run db:migrate && npm run db:seed-dev
#   3. Keep the same values in Setup Node.js App → Environment variables for the running API
# =============================================================================

NODE_ENV=production
PORT=4001

# All API routes are under /api (health → https://cabinet.../api/health)
API_BASE_PATH=/api

# --- PostgreSQL cPanel (socket — même config que migrate) ---
DATABASE_URL=postgres://wilaya67_fodile:PASSWORD@localhost:5432/wilaya67_base1?host=/var/run/postgresql
PGSOCKETDIR=/var/run/postgresql

JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# REFRESH_REUSE_GRACE_MS=10000
COOKIE_SECURE=true

FILE_STORAGE_ROOT=/home/wilaya67/wali-storage
# Malware scan uses cPanel ClamAV (default on). Set false to disable temporarily:
# UPLOAD_MALWARE_SCAN_ENABLED=false
#   /usr/local/cpanel/3rdparty/bin/clamdscan  (primary)
#   /usr/local/cpanel/3rdparty/bin/clamscan   (fallback)
# Staging dir: $FILE_STORAGE_ROOT/uploads/temp (never served via /files)

# Same domain as frontend (SPA + API on one host)
CORS_ORIGIN=https://cabinet.wilaya-tlemcen.dz

LOG_LEVEL=info
TRUST_PROXY=true

DEV_ADMIN_USERNAME=admintranscabinet
DEV_ADMIN_EMAIL=admin@transcabinet.dz
DEV_ADMIN_PASSWORD=12345678
DEV_ADMIN_NAME=Administrateur Cabinet

# Super-admin — upsert ADMIN with is_super_admin=true (soft-delete + guide video write).
# If unset, ensure-super-admin / seed-prod-ensure uses DEV_ADMIN_* above.
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=مسؤول أعلى
# SUPER_ADMIN_EMAIL=

# Web Push — required for browser/phone device notifications.
# Generate once: npx web-push generate-vapid-keys
# Keep the same pair forever (changing keys invalidates all subscriptions).
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@cabinet.wilaya-tlemcen.dz
