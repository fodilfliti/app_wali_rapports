NODE_ENV=development
PORT=4001
DATABASE_URL=postgres://wiliya:wiliya@localhost:5432/wali_rapports
JWT_SECRET=change-me-to-a-secret-at-least-32-characters-long
# Access JWT lifetime (default 15m). Refresh cookie absolute lifetime (default 7d).
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Force Secure refresh cookie (default true in production)
# COOKIE_SECURE=true
FILE_STORAGE_ROOT=storage
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
# Day-to-day: info (readable). Use debug only when digging into a bug.
LOG_LEVEL=info

# Optional: print Sequelize SQL to stdout (noisy — off by default)
# SEQUELIZE_LOGGING=true

# Production only: mount routes under /api (leave unset in local dev)
# API_BASE_PATH=/api

# Dev admin (full access) — login uses username + password
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@tlemcen.local
DEV_ADMIN_PASSWORD=Admin123!
DEV_ADMIN_NAME=Administrateur Wilaya
