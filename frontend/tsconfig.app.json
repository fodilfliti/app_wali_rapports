{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@wali/access-policy": ["../shared/access-policy/src/index.ts"],
      "@wali/access-policy/*": ["../shared/access-policy/src/*"],
      "@wali/routes": ["../shared/routes/src/index.ts"],
      "@wali/routes/*": ["../shared/routes/src/*"]
    }
  },
  "include": ["src", "../shared/access-policy/src", "../shared/routes/src"]
}
